# Docker Compose environment variables for sticker-store-website
# Copy to .env and fill values before running:
#   cp .env.example .env

# Flask app secrets (required: backend refuses to start if unset).
# Generate each with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-random-string
JWT_SECRET_KEY=replace-with-another-random-string

# CORS origins for frontend
CORS_ORIGINS=http://localhost:3000,http://localhost

# Mongo config (matches docker-compose defaults)
MONGO_URI=mongodb://mongo:27017/auth_db
MONGODB_DB_NAME=auth_db

# Cloudflare R2 config (required for real product images)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=sticker-shop
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Public base URL used by frontend image links.
# Example:
# R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
R2_PUBLIC_BASE_URL=

# Maximum number of products to seed from R2 on first startup
R2_MAX_PRODUCTS=60
